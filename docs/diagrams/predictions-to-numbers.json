  "cards": [
    {
      "dot": "emerald",
      "title": "Test path (main question)",
      "items": [
        "evaluate.py scores each scenario: metrics, 2,000 case resamples (seed 42), confusion matrix, ROC curves",
        "It refuses to continue unless all 16 scenarios were tested on the same images per case and class",
        "summarize.py draws one case resample for all 16 scenarios, so each ROI - full difference is paired"
      ]
    },
    {
      "dot": "violet",
      "title": "CV path (supplementary)",
      "items": [
        "Each scenario's 5 held-out-fold files are scored per fold, then joined into one out-of-fold file",
        "The paired comparison reuses summarize.paired_comparison on 356 development cases",
        "No CV file contains a test case"
      ]
    },
    {
      "dot": "rose",
      "title": "Final check",
      "items": [
        "verify.py recomputes metrics, intervals, tables and the paired comparison from the prediction files",
        "It also re-derives every selection and checks the test split was read only after it",
        "Report: experiments/main/verification/verification_report.csv"
      ]
    }
  ]
