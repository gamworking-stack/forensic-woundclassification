  "cards": [
    {
      "dot": "emerald",
      "title": "Selection rule",
      "items": [
        "Grid {1e-5, 3e-5, 1e-4} and rule fixed before any S01-S12 run",
        "Highest validation macro-F1 at the run's best epoch; ties: lower validation loss, then smaller lr",
        "Each grid run keeps its own best epoch by the same rule (best.pt)"
      ]
    },
    {
      "dot": "rose",
      "title": "Test guard",
      "items": [
        "Grid runs pass --skip-test, so they never load or predict test rows",
        "tuning_summary.csv is written before the chosen run touches test",
        "The resume does not train again: it predicts validation and test from best.pt"
      ]
    },
    {
      "dot": "amber",
      "title": "Failures and checks",
      "items": [
        "A failed grid job cancels the select job (--kill-on-invalid-dep=yes)",
        "Rerunning submit_all.sh skips lr runs that already have validation predictions",
        "verify.py (T16) re-derives the choice and checks only the chosen run has test predictions"
      ]
    }
  ]
