  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime",
      "items": [
        "Every job runs python inside the Apptainer pytorch-24.11 image with /project bound",
        "Training jobs get one H100 on the gpu partition; ROI crops and the ensemble combine run on compute"
      ]
    },
    {
      "dot": "emerald",
      "title": "Restart safety",
      "items": [
        "submit_all.sh skips a scenario that has test_predictions.csv or a queued job",
        "train.py resumes from last.pt, which is written atomically every epoch"
      ]
    },
    {
      "dot": "rose",
      "title": "Data stays on the HPC",
      "items": [
        "Images, crops and checkpoints are git-ignored; only manifests and reports are committed",
        "Training reads the frozen split or ROI manifest from the repo checkout"
      ]
    }
  ]
