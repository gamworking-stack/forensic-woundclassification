  "cards": [
    {
      "dot": "emerald",
      "title": "No leakage",
      "items": [
        "Every image of one pseudonimized_id lands in one split, checked when the split is made and again on load",
        "ROI crops inherit the case and split of their source image"
      ]
    },
    {
      "dot": "cyan",
      "title": "Fair full vs ROI",
      "items": [
        "The full path keeps only images that also have an ROI crop (full_scope = matched)",
        "evaluate.py stops if two scenarios were tested on different images"
      ]
    },
    {
      "dot": "amber",
      "title": "Test set used once",
      "items": [
        "train.py loads the test split only after training, with best.pt",
        "Test metrics get case-level bootstrap 95% CIs"
      ]
    }
  ]
