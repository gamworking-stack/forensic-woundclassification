  "cards": [
    {
      "dot": "rose",
      "title": "When test is read",
      "items": [
        "train.py loads test rows only after training ends, and not at all with --skip-test",
        "cnn_svm.py extracts test features only after the SVM setting is chosen on validation",
        "gradcam.py draws its 14 test images once (seed 42) and explains the reported models"
      ]
    },
    {
      "dot": "emerald",
      "title": "Never touches test",
      "items": [
        "Grid runs and select_lr.py see validation scores only; tuning_summary.csv is written before the resume",
        "Cross-validation drops test rows before splitting folds, and its runs write validation files only",
        "No cv_folds.csv case is a test case (asserted when the folds are built)"
      ]
    },
    {
      "dot": "slate",
      "title": "After the predictions exist",
      "items": [
        "ensemble.py averages its members' test files and writes the voted file as the ensemble's predictions",
        "Evaluation and verify.py only read prediction files; verify.py checks every rule above (313 checks)"
      ]
    }
  ]
