  "cards": [
    {
      "dot": "emerald",
      "title": "Safe to rerun",
      "items": [
        "A scenario counts as finished once test_predictions.csv exists",
        "Rerunning after a timeout or failure resubmits only unfinished scenarios, which resume from last.pt",
        "watch_jobs.sh follows the .out/.err logs of the printed job IDs and prints sacct when they end"
      ]
    },
    {
      "dot": "amber",
      "title": "Ensemble chain",
      "items": [
        "The combine job waits for all three members (afterok)",
        "If a member fails, SLURM cancels the combine job instead of leaving it pending"
      ]
    }
